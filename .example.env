# Example .env file for running the application.

APP_PORT=3000
FRONTEND_PORT=5173
NODE_ENV=development

# Database credentials:
POSTGRES_USER=sportsnotebook_app
POSTGRES_PASSWORD=password

# DB names:
POSTGRES_DB_ACTIVITIES=activities_db
POSTGRES_DB_EVENTS=events_db
POSTGRES_DB_USERS=users_db

# DB localhost ports (FOR DEVELOPMENT PURPOSES):
POSTGRES_DB_ACTIVITIES_PORT=5433
POSTGRES_DB_USERS_PORT=5434
POSTGRES_DB_EVENTS_PORT=5435
